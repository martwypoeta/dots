{
  // font & editor basics
  "editor.fontFamily": "Input Mono",
  "editor.fontSize": 15,
  "editor.cursorBlinking": "expand",
  "editor.stickyScroll.enabled": false,
  "editor.minimap.enabled": false,

  // terminal & workbench
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.initialHint": false,
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.welcomePage.experimentalOnboarding": false,
  "workbench.colorTheme": "Vitesse Dark Soft",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.browser.openLocalhostLinks": false,
  "workbench.editor.useModal": "some",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.svg": "default"
  },
  "workbench.experimental.modernUIEditorTabStyle": "pill",

  // explorer & files
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "security.workspace.trust.enabled": false,

  // git & github
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",

  // copilot & chat
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.agent.autoFix": true,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "chat.tips.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "chat.agent.sandbox.enabled": "off",
  "chat.agent.maxRequests": 500,
  "chat.permissions.default": "autoApprove",
  "chat.experimental.richLinks.enabled": true,
  "sessions.chat.unifiedWorkspacePicker.enabled": true,
  "sessions.chat.experimental.agentsPickerInAttachContextMenu": true,
  "agents.voice.enabled": true,

  // extensions
  "extensions.ignoreRecommendations": true,

  // updates
  "update.mode": "none",
  "update.showReleaseNotes": false
}
